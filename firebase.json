
{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "alertxband",
          "appId": "1:133764873281:android:e91403c9e2b9b0a7c35ac0",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "alertxband",
          "configurations": {
            "android": "1:133764873281:android:e91403c9e2b9b0a7c35ac0"
          }
        }
      }
    }
  },

  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],

  "firestore": {
    "rules": "firestore.rules"
  },

  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
